{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymm.local/schemas/teacher_guide.schema.json",
  "title": "TYMM Teacher Guide Source V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "course_id", "grade", "theme_id", "title", "status", "authority_policy", "source_manifest", "theme_overview", "production_plan", "sections", "known_issues", "validation_contract"],
  "$defs": {
    "status": {"enum": ["PLANNED", "MIGRATION_READY", "IN_PROGRESS", "REVIEW_REQUIRED", "VERIFIED", "BLOCKED"]},
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "role", "path", "authority_rank", "usage"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "authority_rank": {"type": "integer", "minimum": 1},
        "usage": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ids", "source_locators", "content_class"],
      "properties": {
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_locators": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "content_class": {"enum": ["OFFICIAL_NORMATIVE", "OFFICIAL_TEXTBOOK", "LESSON_PLAN_IMPLEMENTATION", "PEDAGOGICAL_ENRICHMENT", "MIGRATED_LEGACY_GUIDE", "MIXED"]},
        "note": {"type": "string"}
      }
    },
    "guide_item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "label", "item_type", "expected_answer", "acceptance_criteria", "teacher_guidance", "common_misconceptions", "assessment_evidence", "differentiation", "provenance"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "item_type": {"enum": ["QUESTION", "VOCABULARY", "TABLE", "PROCESS", "TEACHER_NOTE", "ASSESSMENT", "PERFORMANCE_TASK", "REFERENCE"]},
        "expected_answer": {"type": ["string", "array", "object", "null"]},
        "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "teacher_guidance": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "common_misconceptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assessment_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "differentiation": {
          "type": "object", "additionalProperties": false,
          "required": ["support", "enrichment"],
          "properties": {
            "support": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "enrichment": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "guide_unit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "title", "printed_page_range", "activity_refs", "outcome_refs", "content_status", "purpose", "items", "provenance"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "printed_page_range": {"type": "string", "minLength": 1},
        "activity_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outcome_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "content_status": {"$ref": "#/$defs/status"},
        "purpose": {"type": "string"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/guide_item"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["section_id", "title", "section_type", "printed_page_range", "block_id", "block_hours", "outcome_refs", "activity_refs", "lesson_plan_refs", "content_status", "guide_units"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "section_type": {"enum": ["THEME_OPENING", "READING", "SPEAKING", "LISTENING_VIEWING", "WRITING", "THEME_ASSESSMENT"]},
        "printed_page_range": {"type": "string", "minLength": 1},
        "block_id": {"type": ["string", "null"]},
        "block_hours": {"type": ["integer", "null"], "minimum": 1},
        "outcome_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "activity_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "lesson_plan_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "content_status": {"$ref": "#/$defs/status"},
        "guide_units": {"type": "array", "items": {"$ref": "#/$defs/guide_unit"}}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "TYMM_TEACHER_GUIDE_SOURCE"},
    "course_id": {"type": "string", "minLength": 1},
    "grade": {"type": "integer", "minimum": 1, "maximum": 12},
    "theme_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "authority_policy": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rank", "source_role", "rule"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "source_role": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_manifest": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/source_ref"}},
    "theme_overview": {
      "type": "object", "additionalProperties": false,
      "required": ["printed_page_range", "core_instruction_hours", "anlama_hours", "anlatma_hours", "outcome_count", "legacy_guide_coverage", "target_guide_coverage", "target_section_count"],
      "properties": {
        "printed_page_range": {"type": "string"},
        "core_instruction_hours": {"type": "integer", "minimum": 1},
        "anlama_hours": {"type": "integer", "minimum": 0},
        "anlatma_hours": {"type": "integer", "minimum": 0},
        "outcome_count": {"type": "integer", "minimum": 1},
        "legacy_guide_coverage": {"type": "string"},
        "target_guide_coverage": {"type": "string"},
        "target_section_count": {"type": "integer", "minimum": 1}
      }
    },
    "production_plan": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase", "name", "status", "deliverables"],
        "properties": {
          "phase": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "status": {"$ref": "#/$defs/status"},
          "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issue_id", "severity", "status", "description", "source_refs", "resolution_rule"],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["INFO", "WARNING", "ERROR"]},
          "status": {"enum": ["OPEN", "RESOLVED", "ACCEPTED"]},
          "description": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "resolution_rule": {"type": "string", "minLength": 1}
        }
      }
    },
    "validation_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["required_checks", "current_status"],
      "properties": {
        "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "current_status": {"enum": ["NOT_RUN", "PASS", "PASS_WITH_WARNINGS", "FAIL"]}
      }
    }
  }
}
