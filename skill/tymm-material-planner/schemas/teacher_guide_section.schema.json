{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymm.local/schemas/teacher_guide_section.schema.json",
  "title": "Generic TYMM Teacher Guide Section V1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "course_id", "section_id", "title", "content_status", "guide_units", "provenance"],
  "$defs": {
    "status": {"enum": ["PLANNED", "MIGRATION_READY", "IN_PROGRESS", "REVIEW_REQUIRED", "VERIFIED", "BLOCKED"]},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ids", "source_locators", "content_class"],
      "properties": {
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_locators": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "content_class": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "differentiation": {
      "type": "object", "additionalProperties": false,
      "required": ["support", "enrichment"],
      "properties": {
        "support": {"type": ["string", "array", "object", "null"]},
        "enrichment": {"type": ["string", "array", "object", "null"]}
      }
    },
    "guide_item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "label", "item_type", "acceptance_criteria", "teacher_guidance", "common_misconceptions", "assessment_evidence", "differentiation", "provenance"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "printed_page_range": {"type": "string", "minLength": 1},
        "page_locator": {"type": ["string", "array", "object", "null"]},
        "source_locator": {"type": ["string", "array", "object", "null"]},
        "label": {"type": "string", "minLength": 1},
        "item_type": {"type": "string", "minLength": 1},
        "content_status": {"$ref": "#/$defs/status"},
        "expected_answer": {"type": ["string", "array", "object", "null"]},
        "expected_response": {"type": ["string", "array", "object", "null"]},
        "acceptance_criteria": {"type": ["string", "array", "object", "null"]},
        "teacher_guidance": {"type": ["string", "array", "object", "null"]},
        "common_misconceptions": {"type": ["string", "array", "object", "null"]},
        "assessment_evidence": {"type": ["string", "array", "object", "null"]},
        "differentiation": {"$ref": "#/$defs/differentiation"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_type", "target_id"],
            "properties": {
              "target_type": {"type": "string", "minLength": 1},
              "target_id": {"type": "string", "minLength": 1},
              "relation_type": {"type": "string", "minLength": 1},
              "targetType": {"type": "string", "minLength": 1},
              "targetId": {"type": "string", "minLength": 1},
              "relationType": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "guide_unit": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "title", "items", "provenance"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "printed_page_range": {"type": "string", "minLength": 1},
        "page_locator": {"type": ["string", "array", "object", "null"]},
        "source_locator": {"type": ["string", "array", "object", "null"]},
        "activity_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outcome_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "content_status": {"$ref": "#/$defs/status"},
        "purpose": {"type": ["string", "array", "object", "null"]},
        "items": {"type": "array", "items": {"$ref": "#/$defs/guide_item"}},
        "provenance": {"$ref": "#/$defs/provenance"},
        "relations": {"type": "array", "items": {"type": "object"}}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "document_type": {"const": "TYMM_TEACHER_GUIDE_SECTION"},
    "course_id": {"type": "string", "minLength": 1},
    "theme_id": {"type": "string", "minLength": 1},
    "scope_type": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "section_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "section_type": {"type": "string", "minLength": 1},
    "printed_page_range": {"type": "string", "minLength": 1},
    "page_locator": {"type": ["string", "array", "object", "null"]},
    "source_locator": {"type": ["string", "array", "object", "null"]},
    "content_status": {"$ref": "#/$defs/status"},
    "outcome_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "activity_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lesson_plan_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "guide_units": {"type": "array", "items": {"$ref": "#/$defs/guide_unit"}},
    "section_principles": {"type": ["string", "array", "object", "null"]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "relations": {"type": "array", "items": {"type": "object"}}
  }
}
