{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymm.local/schemas/teacher_guide_book_mirror.schema.json",
  "title": "TYMM Teacher Guide Book Mirror V2.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "course_id",
    "theme_id",
    "scope",
    "source_policy",
    "entries",
    "page_checklist"
  ],
  "properties": {
    "schema_version": {"const": "2.3.0"},
    "document_type": {"const": "TYMM_TEACHER_GUIDE_BOOK_MIRROR"},
    "course_id": {"type": "string", "minLength": 1},
    "theme_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["printed_page_range", "status"],
      "properties": {
        "printed_page_range": {"type": "string", "minLength": 1},
        "status": {"enum": ["PILOT", "REVIEW_REQUIRED", "REFERENCE_QUALITY"]}
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_source", "prompt_modes", "locator_only_policy"],
      "properties": {
        "primary_source": {"type": "string", "minLength": 1},
        "prompt_modes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["VERBATIM_SHORT", "VERIFIED_SUMMARY", "LOCATOR_ONLY"]}
        },
        "locator_only_policy": {"type": "string", "minLength": 1}
      }
    },
    "guide_principles": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "page_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["printed_page_range", "check"],
        "properties": {
          "printed_page_range": {"type": "string", "minLength": 1},
          "check": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mirror_id",
        "section_id",
        "printed_page_range",
        "book_heading",
        "presentation_type",
        "canonical_item_refs"
      ],
      "properties": {
        "mirror_id": {"type": "string", "minLength": 1},
        "section_id": {"type": "string", "minLength": 1},
        "unit_id": {"type": ["string", "null"]},
        "printed_page_range": {"type": "string", "minLength": 1},
        "book_heading": {"type": "string", "minLength": 1},
        "presentation_type": {
          "enum": ["QUESTION", "PROCESS", "REFERENCE", "VOCABULARY", "TABLE", "COMPARISON", "ASSESSMENT"]
        },
        "canonical_item_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "prompt_display": {"type": ["string", "null"]},
        "prompt_mode": {
          "type": ["string", "null"],
          "enum": ["VERBATIM_SHORT", "VERIFIED_SUMMARY", "LOCATOR_ONLY", null]
        },
        "teacher_note": {"type": ["string", "array", "null"], "items": {"type": "string", "minLength": 1}},
        "show_acceptance": {"type": "boolean", "default": false},
        "show_common_misconceptions": {"type": "boolean", "default": false},
        "show_differentiation": {"type": "boolean", "default": false},
        "rights_mode": {
          "enum": ["PAGE_REFERENCE", "DERIVED_ACTIVITY", "LIMITED_QUOTATION"]
        },
        "source_locator": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"presentation_type": {"const": "QUESTION"}}},
          "then": {"required": ["prompt_display", "prompt_mode"]}
        }
      ]
    }
  }
}
