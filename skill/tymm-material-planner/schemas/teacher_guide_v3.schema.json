{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymm.local/schemas/teacher_guide_v3.schema.json",
  "title": "TYMM Teacher Guide V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "course_id",
    "grade",
    "theme_id",
    "title",
    "status",
    "generator",
    "source_policy",
    "canonical_sources",
    "sections",
    "tasks",
    "coverage",
    "provenance"
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "pageRange": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "origin",
        "source_ids",
        "source_locators",
        "verbatim",
        "derived_from",
        "transformation",
        "verification_status"
      ],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "origin": {
          "enum": [
            "official_curriculum",
            "official_textbook",
            "official_meb_document",
            "official_regulation",
            "authoritative_external_source",
            "generated_activity",
            "pedagogical_recommendation"
          ]
        },
        "source_ids": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "source_locators": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "verbatim": {"type": "boolean"},
        "derived_from": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "transformation": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["VERIFIED", "REVIEW", "UNVERIFIED", "CONFLICTED", "NOT_FOUND"]},
        "note": {"type": "string"}
      }
    },
    "fieldProvenance": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/provenance"}
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "title",
        "section_type",
        "printed_page_range",
        "activity_refs",
        "outcome_refs",
        "task_ids",
        "provenance"
      ],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "section_type": {"type": "string", "minLength": 1},
        "printed_page_range": {"$ref": "#/$defs/pageRange"},
        "activity_refs": {"$ref": "#/$defs/stringArray"},
        "outcome_refs": {"$ref": "#/$defs/stringArray"},
        "task_ids": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "content_status": {"enum": ["VERIFIED", "REVIEW_REQUIRED"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "section_id",
        "unit_id",
        "task_type",
        "book_heading",
        "printed_page_range",
        "book_prompt",
        "prompt_mode",
        "prompt_status",
        "source_context",
        "expected_answer",
        "answer_status",
        "answer_explanation",
        "why_it_matters",
        "activity_refs",
        "outcome_refs",
        "canonical_item_refs",
        "answer_component_keys",
        "source_locators",
        "evidence_anchor",
        "provenance",
        "field_provenance",
        "content_status",
        "split_from_group"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "section_id": {"type": "string", "minLength": 1},
        "unit_id": {"type": ["string", "array", "null"], "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "task_type": {
          "enum": ["QUESTION", "ACTIVITY", "PROCESS", "PERFORMANCE_TASK", "REFERENCE", "VOCABULARY", "TABLE", "COMPARISON", "ASSESSMENT"]
        },
        "book_heading": {"type": "string", "minLength": 1},
        "generation_profile": {"type": "string", "minLength": 1},
        "focus": {"type": "string", "minLength": 1},
        "printed_page_range": {"$ref": "#/$defs/pageRange"},
        "book_prompt": {"type": ["string", "null"]},
        "prompt_mode": {"enum": ["VERBATIM_SHORT", "VERIFIED_SUMMARY", "LOCATOR_ONLY", "REVIEW_REQUIRED"]},
        "prompt_status": {"enum": ["VERIFIED", "REVIEW_REQUIRED"]},
        "question_number": {"type": ["string", "null"]},
        "source_context": {"type": ["string", "array", "object", "null"]},
        "expected_answer": {},
        "expected_response": {},
        "acceptable_answers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "answer_status": {"enum": ["VERIFIED", "OPEN_ENDED", "NOT_APPLICABLE", "REVIEW_REQUIRED"]},
        "answer_explanation": {"type": "string", "minLength": 40},
        "teacher_background": {"type": ["string", "null"], "minLength": 40},
        "student_explanation": {"type": ["string", "null"], "minLength": 20},
        "why_it_matters": {"type": "string", "minLength": 20},
        "teacher_moves": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "follow_up_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "common_misconceptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "misconception_interventions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_anchor": {"type": ["string", "array", "object"], "minLength": 1},
        "assessment_look_fors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "support": {"type": ["string", "array", "object", "null"]},
        "enrichment": {"type": ["string", "array", "object", "null"]},
        "board_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "activity_refs": {"$ref": "#/$defs/stringArray"},
        "outcome_refs": {"$ref": "#/$defs/stringArray"},
        "canonical_item_refs": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "answer_component_keys": {"$ref": "#/$defs/stringArray"},
        "source_locators": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"},
        "field_provenance": {"$ref": "#/$defs/fieldProvenance"},
        "content_status": {"enum": ["VERIFIED", "REVIEW_REQUIRED"]},
        "review_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "split_from_group": {"type": "boolean"},
        "group_source_task_id": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "document_type": {"const": "TYMM_TEACHER_GUIDE_V3"},
    "course_id": {"type": "string", "minLength": 1},
    "grade": {"type": "integer", "minimum": 1, "maximum": 12},
    "theme_id": {"type": "string", "pattern": "^TEMA_[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "REVIEW_REQUIRED", "REFERENCE_QUALITY"]},
    "generator": {"const": "TEXTBOOK_FIRST_TEACHER_GUIDE_V3"},
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_source", "authority_chain", "prompt_policy", "phase_profile_role"],
      "properties": {
        "primary_source": {"const": "official_textbook_pdf"},
        "authority_chain": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "prompt_policy": {"type": "string", "minLength": 1},
        "phase_profile_role": {"type": "string", "minLength": 1}
      }
    },
    "canonical_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["textbook_pdf", "textbook_map", "curriculum_map", "teacher_guide_canonical", "textbook_task_index"],
      "properties": {
        "textbook_pdf": {"type": "object", "additionalProperties": true},
        "textbook_map": {"type": "object", "additionalProperties": true},
        "curriculum_map": {"type": "object", "additionalProperties": true},
        "curriculum_normative_text": {"type": "object", "additionalProperties": true},
        "teacher_guide_canonical": {"type": "object", "additionalProperties": true},
        "textbook_question_inventory": {"type": "object", "additionalProperties": true},
        "textbook_task_index": {"type": "object", "additionalProperties": true}
      }
    },
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/section"}},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textbook_question_count",
        "guide_question_count",
        "textbook_activity_count",
        "covered_activity_count",
        "uncovered_textbook_questions",
        "uncovered_required_activities",
        "locator_only_questions",
        "unresolved_prompt_text",
        "review_required_items",
        "duplicate_task_ids",
        "generic_fallback_task_count"
      ],
      "properties": {
        "textbook_question_count": {"type": "integer", "minimum": 0},
        "guide_question_count": {"type": "integer", "minimum": 0},
        "textbook_activity_count": {"type": "integer", "minimum": 0},
        "covered_activity_count": {"type": "integer", "minimum": 0},
        "uncovered_textbook_questions": {"$ref": "#/$defs/stringArray"},
        "uncovered_required_activities": {"$ref": "#/$defs/stringArray"},
        "locator_only_questions": {"$ref": "#/$defs/stringArray"},
        "unresolved_prompt_text": {"$ref": "#/$defs/stringArray"},
        "review_required_items": {"$ref": "#/$defs/stringArray"},
        "duplicate_task_ids": {"$ref": "#/$defs/stringArray"},
        "generic_fallback_task_count": {"type": "integer", "minimum": 0},
        "source_page_mismatches": {"$ref": "#/$defs/stringArray"}
      }
    },
    "rendered_markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"$ref": "#/$defs/provenance"}
  }
}
