{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymm.local/schemas/pedagogical_package_design.schema.json",
  "title": "TYMM Pedagogical Package Design Overlay V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "course_id", "packages"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "course_id": {"type": "string", "minLength": 1},
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "route_id", "lesson_progression"],
        "properties": {
          "package_id": {"type": "string", "minLength": 1},
          "route_id": {"type": "string", "minLength": 1},
          "route_rationale": {"type": "string"},
          "lesson_progression": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lesson_no", "role", "cognitive_operation", "student_evidence", "delta_from_previous"],
              "properties": {
                "lesson_no": {"type": "integer", "minimum": 1},
                "role": {
                  "enum": [
                    "INITIAL_CONSTRUCTION",
                    "DEEPENING",
                    "TRANSFER",
                    "REVISION",
                    "SYNTHESIS",
                    "PERFORMANCE",
                    "REFLECTION"
                  ]
                },
                "cognitive_operation": {"type": "string", "minLength": 1},
                "student_evidence": {"type": "string", "minLength": 1},
                "delta_from_previous": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
