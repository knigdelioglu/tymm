{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymm.local/schemas/lesson_plan.schema.json",
  "title": "TYMM AI Lesson Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "course_id",
    "theme_id",
    "block_id",
    "lesson_hours",
    "plan_title",
    "plan_summary",
    "outcome_codes",
    "used_activity_ids",
    "used_form_ids",
    "lessons",
    "teacher_notes",
    "continuation_summary"
  ],
  "dependentRequired": {
    "assessment_scope": ["assessed_outcome_codes"],
    "assessed_outcome_codes": ["assessment_scope"]
  },
  "$defs": {
    "reference_usage": {
      "enum": ["USED", "DEFERRED", "REFERENCE_ONLY"]
    },
    "grounded_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form_refs", "assessment_artifact_refs", "resource_refs"],
      "properties": {
        "form_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["form_id", "usage"],
            "properties": {
              "form_id": {"type": "string", "minLength": 1},
              "usage": {"$ref": "#/$defs/reference_usage"}
            }
          }
        },
        "assessment_artifact_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "binding_key", "usage"],
            "properties": {
              "artifact_id": {"type": "string", "minLength": 1},
              "binding_key": {"type": "string", "minLength": 1},
              "usage": {"$ref": "#/$defs/reference_usage"}
            }
          }
        },
        "resource_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resource_plan_id", "usage"],
            "properties": {
              "resource_plan_id": {"type": "string", "minLength": 1},
              "usage": {"$ref": "#/$defs/reference_usage"}
            }
          }
        }
      }
    },
    "large_class_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "activation_condition",
        "applies_to_lesson_numbers",
        "parallel_group_count",
        "grouping_strategy",
        "teacher_rotation_strategy",
        "peer_observer_strategy",
        "performance_time_limit_seconds",
        "evidence_equivalence",
        "core_hours_independent_of_school_based_extension"
      ],
      "properties": {
        "mode": {"const": "PARALLEL_GROUPS"},
        "activation_condition": {"type": "string", "minLength": 1},
        "applies_to_lesson_numbers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "parallel_group_count": {"type": "integer", "minimum": 2, "maximum": 8},
        "grouping_strategy": {"type": "string", "minLength": 1},
        "teacher_rotation_strategy": {"type": "string", "minLength": 1},
        "peer_observer_strategy": {"type": "string", "minLength": 1},
        "performance_time_limit_seconds": {"type": "integer", "minimum": 30, "maximum": 300},
        "evidence_equivalence": {"type": "string", "minLength": 1},
        "core_hours_independent_of_school_based_extension": {"const": true},
        "optional_school_based_extension": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "purpose"],
          "properties": {
            "allowed": {"type": "boolean"},
            "purpose": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "classroom_adaptations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_categories",
        "justification",
        "differentiation",
        "accessibility",
        "evidence_equivalence"
      ],
      "properties": {
        "trigger_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["MEDIA_DEPENDENT", "LIVE_PERFORMANCE"]}
        },
        "justification": {"type": "string", "minLength": 1},
        "differentiation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scaffold_route", "enrichment_route", "outcomes_unchanged"],
          "properties": {
            "scaffold_route": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "enrichment_route": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "outcomes_unchanged": {"const": true}
          }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "representation_supports",
            "participation_supports",
            "environment_supports",
            "assessment_construct_preserved"
          ],
          "properties": {
            "representation_supports": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "participation_supports": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "environment_supports": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "assessment_construct_preserved": {"const": true}
          }
        },
        "media_fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "network_independent_core_route",
            "same_source_or_equivalent_required",
            "transcript_is_support_not_default_substitute",
            "offline_route",
            "access_support_route"
          ],
          "properties": {
            "required": {"const": true},
            "network_independent_core_route": {"const": true},
            "same_source_or_equivalent_required": {"const": true},
            "transcript_is_support_not_default_substitute": {"const": true},
            "offline_route": {"type": "string", "minLength": 1},
            "access_support_route": {"type": "string", "minLength": 1}
          }
        },
        "live_performance_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "alternative_modes",
            "same_performance_evidence_required",
            "written_only_substitution_allowed",
            "recording_requires_consent"
          ],
          "properties": {
            "required": {"const": true},
            "alternative_modes": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"enum": ["SMALL_GROUP_LIVE", "TEACHER_OBSERVED_LIVE", "RECORDED_ORAL_IF_ALLOWED"]}
            },
            "same_performance_evidence_required": {"const": true},
            "written_only_substitution_allowed": {"const": false},
            "recording_requires_consent": {"const": true}
          }
        },
        "evidence_equivalence": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "course_id": {"type": "string", "minLength": 1},
    "theme_id": {"type": "string", "minLength": 1},
    "block_id": {"type": "string", "minLength": 1},
    "lesson_hours": {"type": "integer", "minimum": 1},
    "plan_title": {"type": "string", "minLength": 1},
    "plan_summary": {"type": "string", "minLength": 1},
    "instruction_scope": {"const": "BLOCK"},
    "assessment_scope": {"enum": ["BLOCK", "THEME"]},
    "assessed_outcome_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "grounded_references": {"$ref": "#/$defs/grounded_references"},
    "large_class_route": {"$ref": "#/$defs/large_class_route"},
    "classroom_adaptations": {"$ref": "#/$defs/classroom_adaptations"},
    "outcome_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "used_activity_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "used_form_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lesson_no",
          "duration_lesson_hours",
          "title",
          "objective",
          "outcome_codes",
          "opening",
          "teacher_actions",
          "student_actions",
          "activity_ids",
          "form_ids",
          "assessment",
          "closure",
          "materials"
        ],
        "dependentRequired": {
          "assessment_scope": ["assessed_outcome_codes"],
          "assessed_outcome_codes": ["assessment_scope"]
        },
        "properties": {
          "lesson_no": {"type": "integer", "minimum": 1},
          "duration_lesson_hours": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "instruction_scope": {"const": "BLOCK"},
          "assessment_scope": {"enum": ["BLOCK", "THEME"]},
          "assessed_outcome_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "outcome_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "opening": {"type": "string", "minLength": 1},
          "teacher_actions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "student_actions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "activity_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "form_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "assessment": {"type": "string", "minLength": 1},
          "closure": {"type": "string", "minLength": 1},
          "materials": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "teacher_notes": {"type": "string"},
    "continuation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_now_hours",
        "remaining_block_hours",
        "covered_outcome_codes",
        "used_activity_ids",
        "next_step_hint"
      ],
      "properties": {
        "planned_now_hours": {"type": "integer", "minimum": 1},
        "remaining_block_hours": {"type": "integer", "minimum": 0},
        "covered_outcome_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "used_activity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "next_step_hint": {"type": "string"}
      }
    }
  }
}
