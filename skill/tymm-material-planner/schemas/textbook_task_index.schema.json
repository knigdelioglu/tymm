{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tymm.local/schemas/textbook_task_index.schema.json",
  "title": "TYMM Official Textbook Task Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "course_id", "source", "map_ref", "themes", "counts", "provenance"],
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "section_id", "printed_page_range", "book_heading", "book_prompt", "prompt_mode", "prompt_status", "canonical_item_refs", "activity_refs", "source_locator", "source_ids"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "section_id": {"type": "string", "minLength": 1},
        "printed_page_range": {"type": "string", "minLength": 1},
        "book_heading": {"type": "string", "minLength": 1},
        "book_prompt": {"type": ["string", "null"]},
        "prompt_mode": {"enum": ["VERBATIM_SHORT", "VERIFIED_SUMMARY", "LOCATOR_ONLY", "REVIEW_REQUIRED"]},
        "prompt_status": {"enum": ["VERIFIED", "REVIEW_REQUIRED"]},
        "canonical_item_refs": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "activity_refs": {"$ref": "#/$defs/stringArray"},
        "source_locator": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "question_number": {"type": ["string", "null"]},
        "split_from_group": {"type": "boolean"}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_id", "section_id", "activity_title", "printed_page_range", "source_locator", "verification_status"],
      "properties": {
        "activity_id": {"type": "string", "minLength": 1},
        "section_id": {"type": "string", "minLength": 1},
        "activity_title": {"type": "string", "minLength": 1},
        "student_action": {"type": "string", "minLength": 1},
        "expected_product_or_evidence": {"type": "string", "minLength": 1},
        "printed_page_range": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["VERIFIED", "REVIEW_REQUIRED"]}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_id", "printed_page_range", "questions", "activities", "question_task_ids", "activity_ids"],
      "properties": {
        "theme_id": {"type": "string", "minLength": 1},
        "printed_page_range": {"type": "string", "minLength": 1},
        "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
        "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
        "question_task_ids": {"$ref": "#/$defs/stringArray"},
        "activity_ids": {"$ref": "#/$defs/stringArray"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "origin", "source_ids", "source_locators", "verbatim", "derived_from", "transformation", "verification_status"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "origin": {"enum": ["official_textbook", "pedagogical_recommendation"]},
        "source_ids": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "source_locators": {"$ref": "#/$defs/stringArray", "minItems": 1},
        "verbatim": {"type": "boolean"},
        "derived_from": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "transformation": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["VERIFIED", "REVIEW", "UNVERIFIED", "CONFLICTED", "NOT_FOUND"]}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "TYMM_TEXTBOOK_TASK_INDEX"},
    "course_id": {"type": "string", "minLength": 1},
    "source": {"type": "object", "additionalProperties": true, "required": ["source_id", "path", "sha256", "verification_status"]},
    "map_ref": {"type": "string", "minLength": 1},
    "themes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/theme"}},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themes", "questions", "activities"],
      "properties": {
        "themes": {"type": "integer", "minimum": 1},
        "questions": {"type": "integer", "minimum": 0},
        "activities": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  }
}
